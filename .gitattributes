# Auto detect text files and perform LF normalization
* text=auto

# C# and .NET files (CRLF on Windows)
*.cs text eol=crlf diff=csharp
*.csproj text eol=crlf
*.sln text eol=crlf
*.config text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# Shell scripts
*.ps1 text eol=crlf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Data and documentation
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=crlf
*.txt text eol=lf
*.editorconfig text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
LICENSE text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.exe binary
*.pdb binary
*.zip binary
*.nupkg binary
